{
  "name": "ug-life",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && tsc -p functions/tsconfig.json && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p functions/tsconfig.json",
    "db:local": "wrangler d1 migrations apply ug-life-db --local",
    "serve:local": "wrangler pages dev dist --port 8788"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250924.0",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vite-plugin-singlefile": "2.2.0",
    "vitest": "3.2.4",
    "wrangler": "^4.40.0"
  }
}
